[Unit]
Description=WhiteHacker portfolio — Next.js frontend
After=network-online.target whitehacker-api.service
Wants=whitehacker-api.service

[Service]
Type=simple
User=whportfolio
Group=whportfolio
WorkingDirectory=/var/www/whitehacker-portfolio/web
# -H 127.0.0.1: faqat nginx orqali ochilsin, tashqaridan to'g'ridan-to'g'ri emas.
ExecStart=/var/www/whitehacker-portfolio/node_modules/.bin/next start -H 127.0.0.1 -p 3000
Restart=always
RestartSec=5
Environment=NODE_ENV=production
Environment=API_INTERNAL_URL=http://127.0.0.1:4000
# SEO: canonical havolalar, sitemap va JSON-LD shu manzildan yasaladi.
Environment=SITE_URL=https://whitehacker-portfolio.duckdns.org

NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/www/whitehacker-portfolio/web/.next

StandardOutput=journal
StandardError=journal
SyslogIdentifier=whitehacker-web

[Install]
WantedBy=multi-user.target
