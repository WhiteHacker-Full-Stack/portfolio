# --- Database (Prisma / SQLite) ---
DATABASE_URL="file:./dev.db"

# --- Admin auth ---
JWT_SECRET="change-me-to-a-long-random-string"
# Used only by `npm run db:seed` to create the single admin account.
ADMIN_USERNAME="whitehacker"
ADMIN_PASSWORD="change-me"

# --- Telegram ---
# Create a bot via @BotFather, then add it as an admin to your channel.
TELEGRAM_BOT_TOKEN=""
# Either the numeric channel id (-1001234567890) or "@channelusername".
TELEGRAM_CHANNEL_ID=""

# --- YouTube (admin paneldan video yuklash) ---
# Google Cloud Console → YouTube Data API v3 yoqiladi → OAuth 2.0 Client ID (Desktop app).
YOUTUBE_CLIENT_ID=""
YOUTUBE_CLIENT_SECRET=""
# `npm run youtube:auth` bir marta ishga tushirilib olinadi.
YOUTUBE_REFRESH_TOKEN=""
# Katta video fayllar YouTube'ga uzatilgunicha shu yerda turadi.
VIDEO_TMP_DIR="/tmp/wh-video-uploads"

# --- URLs ---
# Public origin of the site — used to build the [Batafsil] button link in Telegram posts.
SITE_URL="http://localhost:3000"
# Express API port.
PORT=4000
# Comma-separated list of origins allowed to call the API (web + future Capacitor app).
CORS_ORIGINS="http://localhost:3000,capacitor://localhost,http://localhost"

# --- Uploads ---
# Where uploaded documents / cover images are written, relative to the repo root.
# Served by Next.js at /uploads/* and by Express at $API/uploads/*.
UPLOAD_DIR="web/public/uploads"

# --- Next.js (web) ---
# Server-side base URL the Next.js server uses to reach the Express API.
API_INTERNAL_URL="http://localhost:4000"
